#!/usr/bin/env python3
"""office.ad helper. status is unprivileged; mutations need root (pkexec)."""
from __future__ import annotations

import ipaddress
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import time
from pathlib import Path

STATE_PATH = Path("/etc/omarchy-ad/state.json")
SMB_CONF = Path("/etc/samba/smb.conf")
KEA_CONF = Path("/etc/kea/kea-dhcp4.conf")
GARAGE_CONF = Path("/etc/garage.toml")
GARAGE_DATA = Path("/var/lib/garage")
GARAGE_UNIT = "garage.service"
S3_PORT = 3900
RPC_PORT = 3901
ADMIN_PORT = 3903


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def need_root() -> None:
    if os.geteuid() != 0:
        die("need root (use pkexec)")


HELPER_VERSION = "1.3.0"
KEA_UNITS = ("kea-dhcp4.service", "kea-dhcp4-server.service")
# Arch extra ships garage 2.3: /usr/bin/garage, garage.service (User=garage),
# /etc/garage.toml. CLI verified against v2.3.0 structs.rs: `key create`,
# `bucket allow --key`, `bucket delete --yes`, `layout apply --version`.


def run(cmd: list[str], check: bool = True, timeout: int = 20) -> subprocess.CompletedProcess:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        if check:
            die(f"missing command: {cmd[0]}")
        return subprocess.CompletedProcess(cmd, 127, "", f"missing command: {cmd[0]}")
    except subprocess.TimeoutExpired:
        if check:
            die(f"timeout: {' '.join(cmd)}")
        return subprocess.CompletedProcess(cmd, 124, "", "timeout")
    if check and r.returncode != 0:
        err = (r.stderr or r.stdout or "").strip() or f"failed: {' '.join(cmd)}"
        die(err)
    return r


def set_kea(on: bool) -> None:
    for unit in KEA_UNITS:
        if on:
            run(["systemctl", "enable", "--now", unit], check=False)
        else:
            run(["systemctl", "disable", "--now", unit], check=False)


def unit_active(name: str) -> str:
    r = run(["systemctl", "is-active", name], check=False)
    if r.returncode == 127:
        return "unknown"
    return (r.stdout or r.stderr or "inactive").strip()


def load_state() -> dict:
    if STATE_PATH.is_file():
        try:
            return json.loads(STATE_PATH.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            pass
    return {
        "realm": "",
        "mode": "",
        "dhcp_enabled": True,
        "dns_enabled": True,
        "garage_enabled": False,
        "primary": {},
        "vlans": [],
        "hosts": [],
        "shares": [],
        "users": [],
    }


def save_state(state: dict) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    os.chmod(STATE_PATH, 0o644)


def realm_from_smb() -> str:
    if not SMB_CONF.is_file():
        return ""
    text = SMB_CONF.read_text(encoding="utf-8", errors="replace")
    m = re.search(r"^\s*realm\s*=\s*(\S+)", text, re.I | re.M)
    return m.group(1).strip().lower() if m else ""


def live_ipv4() -> dict:
    out = {"ip": "", "prefix": "24", "interface": "", "gateway": ""}
    try:
        addrs = json.loads(run(["ip", "-4", "-j", "addr"], check=False).stdout or "[]")
        for iface in addrs:
            if iface.get("ifname") == "lo":
                continue
            for a in iface.get("addr_info") or []:
                local = a.get("local") or ""
                if a.get("family") == "inet" and not local.startswith("127."):
                    out["ip"] = local
                    out["prefix"] = str(a.get("prefixlen") or "24")
                    out["interface"] = iface.get("ifname") or ""
                    break
            if out["ip"]:
                break
    except Exception:
        pass
    try:
        rts = json.loads(run(["ip", "-j", "route", "show", "default"], check=False).stdout or "[]")
        if rts:
            out["gateway"] = rts[0].get("gateway") or ""
    except Exception:
        pass
    return out


def parse_shares() -> list[dict]:
    if not SMB_CONF.is_file():
        return []
    skip = {"global", "netlogon", "sysvol", "printers", "print$"}
    shares: list[dict] = []
    share: dict | None = None
    for line in SMB_CONF.read_text(encoding="utf-8", errors="replace").splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            if share and share["name"].lower() not in skip:
                shares.append(share)
            share = {"name": s[1:-1], "path": "", "read_only": "no", "valid_users": ""}
            continue
        if share and "=" in s:
            k, v = [x.strip() for x in s.split("=", 1)]
            kl = k.lower()
            if kl == "path":
                share["path"] = v
            elif kl in ("read only", "readonly"):
                share["read_only"] = v
            elif kl == "valid users":
                share["valid_users"] = v
    if share and share["name"].lower() not in skip:
        shares.append(share)
    return shares


def parse_kea_pools() -> list[dict]:
    if not KEA_CONF.is_file():
        return []
    try:
        data = json.loads(KEA_CONF.read_text(encoding="utf-8"))
    except Exception:
        return []
    rows = []
    for sub in (data.get("Dhcp4") or {}).get("subnet4") or []:
        pool = ""
        pools = sub.get("pools") or []
        if pools:
            pool = pools[0].get("pool") or ""
        start = end = ""
        if " - " in pool:
            start, end = [x.strip() for x in pool.split(" - ", 1)]
        rows.append(
            {
                "subnet": sub.get("subnet") or "",
                "interface": sub.get("interface") or "",
                "dhcp_start": start,
                "dhcp_end": end,
            }
        )
    return rows



def pkg_installed(name: str) -> bool:
    r = run(["pacman", "-Q", "--quiet", name], check=False)
    return r.returncode == 0


def package_catalog(mode: str, dhcp_on: bool, garage_on: bool = False) -> list[dict]:
    rows = [
        ("samba", True, "File shares and directory", True),
        ("wsdd", True, "Windows Network Neighborhood discovery", True),
        ("networkmanager", True, "Static IP and VLAN interfaces", True),
        ("krb5", mode in ("host-ad", "join-ad"), "Kerberos", True),
        ("chrony", mode == "host-ad", "Time sync for AD", True),
        ("python-cryptography", mode == "host-ad", "samba-tool", True),
        ("python-dnspython", mode == "host-ad", "samba-tool DNS", True),
        ("python-markdown", mode == "host-ad", "samba-tool docs", False),
        ("kea", dhcp_on, "DHCP server", True),
        ("kea-docs", dhcp_on, "Kea docs", False),
        ("bind", mode == "host-ad", "host/dig for DNS checks", False),
        ("restic", mode == "host-ad", "AD backups to B2", False),
        ("garage", garage_on, "S3-compatible object store (Deuxfleurs Garage)", True),
    ]
    out = []
    for name, applies, why, required in rows:
        if not applies:
            continue
        inst = pkg_installed(name)
        out.append({
            "name": name,
            "installed": inst,
            "required": required,
            "why": why,
            "missing": required and not inst,
        })
    return out


def cmd_packages_install(_args: list[str]) -> None:
    need_root()
    state = load_state()
    mode = detect_mode(state)
    catalog = package_catalog(
        mode,
        bool(state.get("dhcp_enabled", True)),
        bool(state.get("garage_enabled", False)),
    )
    missing = [p["name"] for p in catalog if p["missing"]]
    if not missing:
        print(json.dumps({"ok": True, "installed": []}))
        return
    if shutil_which("omarchy-pkg-add"):
        cmd = ["omarchy-pkg-add"] + missing
    else:
        cmd = ["pacman", "-S", "--noconfirm", "--needed"] + missing
    r = run(cmd, check=False, timeout=600)
    if r.returncode != 0:
        die((r.stderr or r.stdout or "package install failed").strip())
    print(json.dumps({"ok": True, "installed": missing}))



SAM_LDB = Path("/var/lib/samba/private/sam.ldb")


def is_dc() -> bool:
    return SAM_LDB.is_file()


def smb_role() -> str:
    if not SMB_CONF.is_file():
        return ""
    text = SMB_CONF.read_text(encoding="utf-8", errors="replace")
    if re.search(r"^\s*server role\s*=\s*active directory", text, re.I | re.M):
        return "dc"
    if re.search(r"^\s*security\s*=\s*ads", text, re.I | re.M) or re.search(
        r"^\s*server role\s*=\s*member", text, re.I | re.M
    ):
        return "member"
    if re.search(r"^\s*server role\s*=\s*standalone", text, re.I | re.M) or re.search(
        r"^\s*security\s*=\s*user", text, re.I | re.M
    ):
        return "standalone"
    return ""


def detect_mode(state: dict) -> str:
    saved = state.get("mode") or ""
    if saved in ("host-ad", "join-ad", "local"):
        return saved
    if is_dc():
        return "host-ad"
    role = smb_role()
    if role == "member":
        return "join-ad"
    if role == "standalone":
        return "local"
    return "host-ad"


def list_users(mode: str) -> list:
    users = []
    if mode == "host-ad" and is_dc():
        r = run(["samba-tool", "user", "list"], check=False)
        if r.returncode == 0:
            skip = {"Guest", "krbtgt"}
            for n in r.stdout.splitlines():
                name = n.strip()
                if name and name not in skip:
                    users.append({"name": name, "kind": "domain"})
            return users
    try:
        for line in Path("/etc/passwd").read_text(encoding="utf-8").splitlines():
            parts = line.split(":")
            if len(parts) < 3:
                continue
            name, uid = parts[0], int(parts[2])
            if uid >= 1000 and name not in {"nobody", "nixbld"}:
                users.append({"name": name, "kind": "local", "uid": uid})
    except Exception:
        pass
    return users


def garage_bin() -> str:
    for p in ("/usr/bin/garage", "/usr/local/bin/garage"):
        if Path(p).is_file():
            return p
    from shutil import which
    return which("garage") or "garage"


def garage_run(args: list[str], check: bool = True, timeout: int = 30) -> subprocess.CompletedProcess:
    cmd = [garage_bin(), "-c", str(GARAGE_CONF), *args]
    return run(cmd, check=check, timeout=timeout)


def log_last_apply(payload: dict) -> None:
    blob = json.dumps(payload, indent=2) + "\n"
    logdir = Path("/etc/omarchy-ad")
    try:
        logdir.mkdir(parents=True, exist_ok=True)
        (logdir / "set-services.log").write_text(blob, encoding="utf-8")
    except OSError:
        pass
    tmp = Path("/tmp/omarchy-ad-last-apply.json")
    try:
        tmp.write_text(blob, encoding="utf-8")
        os.chmod(tmp, 0o644)
    except OSError:
        pass


def parse_kv(args: list[str]) -> dict:
    spec: dict = {}
    for a in args:
        a = str(a)
        if a.startswith("{") and "}" in a:
            try:
                spec.update(json.loads(a))
            except json.JSONDecodeError:
                pass
            continue
        if "=" in a:
            k, v = a.split("=", 1)
            spec[k.strip().lstrip("-")] = v.strip()
    return spec


def s3_endpoint_host(state: dict | None = None) -> str:
    live = live_ipv4()
    primary = (state or {}).get("primary") or {}
    ip = primary.get("ip") or live.get("ip") or "127.0.0.1"
    return f"{ip}:{S3_PORT}"


def garage_secret_is_placeholder(value: str) -> bool:
    v = (value or "").strip().strip('"')
    if not v or "GENERATE" in v.upper():
        return True
    return not re.fullmatch(r"[0-9a-fA-F]{64}", v)


def read_garage_toml_field(text: str, key: str) -> str:
    m = re.search(rf"^\s*{re.escape(key)}\s*=\s*\"([^\"]*)\"", text, re.M)
    if m:
        return m.group(1)
    m = re.search(rf"^\s*{re.escape(key)}\s*=\s*(\S+)", text, re.M)
    return (m.group(1) if m else "").strip().strip('"')


def garage_conf_needs_init() -> bool:
    if not GARAGE_CONF.is_file():
        return True
    text = GARAGE_CONF.read_text(encoding="utf-8", errors="replace")
    return garage_secret_is_placeholder(read_garage_toml_field(text, "rpc_secret"))


def write_garage_config(state: dict) -> None:
    """Write /etc/garage.toml on first enable. Keep existing real secrets."""
    if not garage_conf_needs_init():
        return
    live = live_ipv4()
    primary = state.get("primary") or {}
    ip = primary.get("ip") or live.get("ip") or "127.0.0.1"
    rpc_secret = secrets.token_hex(32)
    admin_token = secrets.token_hex(32)
    metrics_token = secrets.token_hex(32)
    body = (
        "# Written by omarchy-adctl for a single-node office Garage.\n"
        "# replication_factor = 1 (one node). Do not print secrets in status.\n"
        "replication_factor = 1\n"
        'metadata_dir = "/var/lib/garage/meta"\n'
        'data_dir = "/var/lib/garage/data"\n'
        'metadata_snapshots_dir = "/var/lib/garage/snapshots"\n'
        'db_engine = "sqlite"\n'
        "\n"
        f'rpc_secret = "{rpc_secret}"\n'
        f'rpc_bind_addr = "[::]:{RPC_PORT}"\n'
        f'rpc_public_addr = "{ip}:{RPC_PORT}"\n'
        "allow_world_readable_secrets = false\n"
        "\n"
        "[s3_api]\n"
        f'api_bind_addr = "[::]:{S3_PORT}"\n'
        's3_region = "garage"\n'
        'root_domain = ".s3.garage"\n'
        "\n"
        "[admin]\n"
        f'api_bind_addr = "127.0.0.1:{ADMIN_PORT}"\n'
        f'admin_token = "{admin_token}"\n'
        f'metrics_token = "{metrics_token}"\n'
        "metrics_require_token = true\n"
    )
    GARAGE_CONF.parent.mkdir(parents=True, exist_ok=True)
    GARAGE_CONF.write_text(body, encoding="utf-8")
    os.chmod(GARAGE_CONF, 0o640)
    try:
        import pwd
        import grp
        uid = pwd.getpwnam("garage").pw_uid
        gid = grp.getgrnam("garage").gr_gid
        os.chown(GARAGE_CONF, uid, gid)
    except KeyError:
        pass


def ensure_garage_dirs() -> None:
    for sub in ("", "meta", "data", "snapshots"):
        path = GARAGE_DATA / sub if sub else GARAGE_DATA
        path.mkdir(parents=True, exist_ok=True)
        os.chmod(path, 0o750)
        try:
            import pwd
            import grp
            uid = pwd.getpwnam("garage").pw_uid
            gid = grp.getgrnam("garage").gr_gid
            os.chown(path, uid, gid)
        except KeyError:
            pass


def ensure_garage_user() -> None:
    sysusers = Path("/usr/lib/sysusers.d/garage.conf")
    tmpfiles = Path("/usr/lib/tmpfiles.d/garage.conf")
    if sysusers.is_file():
        run(["systemd-sysusers", str(sysusers)], check=False)
    if tmpfiles.is_file():
        run(["systemd-tmpfiles", "--create", str(tmpfiles)], check=False)
    if run(["id", "garage"], check=False).returncode != 0:
        die("garage system user missing; install the Arch extra package: pacman -S garage")


def ensure_garage_installed() -> None:
    if Path("/usr/bin/garage").is_file():
        return
    from shutil import which
    if which("omarchy-pkg-add"):
        r = run(["omarchy-pkg-add", "garage"], check=False, timeout=600)
    else:
        r = run(["pacman", "-S", "--noconfirm", "--needed", "garage"], check=False, timeout=600)
    if r.returncode != 0 or not Path("/usr/bin/garage").is_file():
        err = (r.stderr or r.stdout or "").strip()
        die(
            (err + "\n" if err else "")
            + "Garage is not installed. Arch extra package: pacman -S garage "
            "(or omarchy-pkg-add garage). Binary builds: https://garagehq.deuxfleurs.fr/download/"
        )


def parse_garage_node_id(text: str) -> str:
    for line in text.splitlines():
        s = line.strip()
        if not s or " " in s.split("@")[0]:
            continue
        if re.match(r"^[0-9a-fA-F]{8,}@", s) or re.fullmatch(r"[0-9a-fA-F]{16,}", s):
            return s.split("@", 1)[0]
    return ""


def garage_node_id() -> str:
    r = garage_run(["node", "id", "-q"], check=False)
    nid = parse_garage_node_id(r.stdout or "")
    if nid:
        return nid
    r = garage_run(["status"], check=False)
    for line in (r.stdout or "").splitlines():
        parts = line.split()
        if parts and re.match(r"^[0-9a-fA-F]{8,}", parts[0].rstrip("….")):
            return parts[0].rstrip("….…")
    die("could not read garage node id")
    return ""


def garage_layout_version(text: str) -> int:
    m = re.search(r"layout version:\s*(\d+)", text, re.I)
    return int(m.group(1)) if m else 0


def garage_needs_layout() -> bool:
    r = garage_run(["status"], check=False)
    out = (r.stdout or "") + (r.stderr or "")
    if r.returncode != 0:
        return True
    return "NO ROLE ASSIGNED" in out


def garage_capacity() -> str:
    try:
        st = os.statvfs(str(GARAGE_DATA) if GARAGE_DATA.is_dir() else "/")
        gb = max(1, (st.f_frsize * st.f_blocks) // (1024 ** 3))
        return f"{gb}GB"
    except OSError:
        return "100GB"


def wait_garage(timeout: int = 30) -> None:
    deadline = time.time() + timeout
    last = "no output"
    while time.time() < deadline:
        r = garage_run(["status"], check=False, timeout=8)
        if r.returncode == 0 and (r.stdout or "").strip():
            return
        last = ((r.stderr or r.stdout or "").strip() or last)
        time.sleep(1)
    die("garage did not become ready: " + last.split("\n")[0])


def init_garage_layout() -> None:
    """Idempotent single-node layout, replication_factor 1."""
    if not garage_needs_layout():
        return
    nid = garage_node_id()
    cap = garage_capacity()
    staged = garage_run(
        ["layout", "assign", "-z", "office", "-c", cap, nid],
        check=False,
    )
    if staged.returncode != 0:
        die((staged.stderr or staged.stdout or "layout assign failed").strip())
    shown = garage_run(["layout", "show"], check=False)
    ver = garage_layout_version(shown.stdout or "")
    nxt = ver + 1 if ver >= 0 else 1
    if ver == 0:
        nxt = 1
    applied = garage_run(["layout", "apply", "--version", str(nxt)], check=False)
    if applied.returncode != 0:
        applied = garage_run(["layout", "apply"], check=False)
    if applied.returncode != 0:
        err = (applied.stderr or applied.stdout or "").strip()
        if garage_needs_layout():
            die(err or "layout apply failed")


def parse_garage_bucket_list(text: str) -> list[dict]:
    buckets: list[dict] = []
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("=") or s.lower().startswith("id"):
            continue
        parts = s.split()
        if not parts:
            continue
        bid = parts[0]
        name = ""
        for p in parts[1:]:
            if re.match(r"^\d{4}-\d{2}-\d{2}", p) or re.match(r"^\d{2}:\d{2}", p):
                continue
            name = p
            break
        buckets.append({"id": bid, "name": name or bid})
    return buckets


def parse_garage_key_list(text: str) -> list[dict]:
    keys: list[dict] = []
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("=") or s.lower().startswith("id"):
            continue
        parts = s.split()
        if not parts:
            continue
        kid = parts[0]
        mid = []
        for p in parts[1:]:
            if re.match(r"^\d{4}-\d{2}-\d{2}", p) or re.match(r"^\d{2}:\d{2}", p):
                continue
            mid.append(p)
        if mid and mid[-1].lower() in ("never", "expired"):
            mid = mid[:-1]
        keys.append({"id": kid, "name": " ".join(mid)})
    return keys


def parse_key_create(text: str) -> dict:
    out = {"key_id": "", "key_name": "", "secret_key": ""}
    for line in text.splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        kl = re.sub(r"\s+", " ", k).strip().lower()
        v = v.strip()
        if kl in ("key id", "key_id"):
            out["key_id"] = v
        elif kl in ("key name", "key_name"):
            out["key_name"] = v
        elif kl in ("secret key", "secret_key"):
            out["secret_key"] = v
    return out


def list_garage_buckets_live() -> list[dict]:
    r = garage_run(["bucket", "list"], check=False)
    if r.returncode != 0:
        return []
    return parse_garage_bucket_list(r.stdout or "")


def list_garage_keys_live() -> list[dict]:
    r = garage_run(["key", "list"], check=False)
    if r.returncode != 0:
        return []
    return parse_garage_key_list(r.stdout or "")


def cache_garage_inventory(state: dict) -> dict:
    """Root can read /etc/garage.toml; the panel user often cannot (0640)."""
    if unit_active(GARAGE_UNIT) == "active" and os.access(str(GARAGE_CONF), os.R_OK):
        state["garage_buckets"] = list_garage_buckets_live()
        state["garage_keys"] = list_garage_keys_live()
    return state


def list_garage_buckets(state: dict | None = None) -> list[dict]:
    state = state if state is not None else load_state()
    cached = state.get("garage_buckets") or []
    if unit_active(GARAGE_UNIT) != "active":
        return cached
    if not os.access(str(GARAGE_CONF), os.R_OK):
        return cached
    live = list_garage_buckets_live()
    return live if live or not cached else cached


def list_garage_keys(state: dict | None = None) -> list[dict]:
    state = state if state is not None else load_state()
    cached = state.get("garage_keys") or []
    if unit_active(GARAGE_UNIT) != "active":
        return cached
    if not os.access(str(GARAGE_CONF), os.R_OK):
        return cached
    live = list_garage_keys_live()
    return live if live or not cached else cached


def set_garage(on: bool, state: dict) -> None:
    if not on:
        run(["systemctl", "disable", "--now", GARAGE_UNIT], check=False)
        return
    ensure_garage_installed()
    ensure_garage_user()
    ensure_garage_dirs()
    write_garage_config(state)
    r = run(["systemctl", "enable", "--now", GARAGE_UNIT], check=False, timeout=60)
    if r.returncode != 0 and unit_active(GARAGE_UNIT) != "active":
        err = (r.stderr or r.stdout or "").strip() or unit_active(GARAGE_UNIT)
        die("could not start garage.service: " + err)
    wait_garage()
    init_garage_layout()
    cache_garage_inventory(state)
    save_state(state)


def valid_bucket_name(name: str) -> bool:
    return bool(re.fullmatch(r"[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]", name))


def valid_key_name(name: str) -> bool:
    return bool(re.fullmatch(r"[a-zA-Z0-9._-]{1,64}", name))


def cmd_status(_args: list[str]) -> None:
    live = live_ipv4()
    state = load_state()
    primary = dict(state.get("primary") or {})
    for k, v in live.items():
        primary.setdefault(k, v)
        if not primary.get(k):
            primary[k] = v
    realm = state.get("realm") or realm_from_smb()
    mode = detect_mode(state)
    dhcp_on = state.get("dhcp_enabled", True)
    dns_on = state.get("dns_enabled", True)
    garage_on = bool(state.get("garage_enabled", False))
    samba = unit_active("samba.service")
    smb = unit_active("smb.service")
    endpoint = s3_endpoint_host(state)
    out = {
        "hostname": socket.gethostname(),
        "mode": mode,
        "samba": samba,
        "smb": smb,
        "winbind": unit_active("winbind.service"),
        "kea": unit_active("kea-dhcp4.service"),
        "wsdd": unit_active("wsdd.service"),
        "garage": unit_active(GARAGE_UNIT),
        "installed": is_dc() if mode == "host-ad" else SMB_CONF.is_file(),
        "is_dc": is_dc(),
        "dhcp_enabled": bool(dhcp_on),
        "dns_enabled": bool(dns_on),
        "garage_enabled": garage_on,
        "s3_endpoint": endpoint,
        "s3_region": "garage",
        "s3_path_style": True,
        "s3_example": f"aws --endpoint-url http://{endpoint} s3 ls",
        "buckets": list_garage_buckets(state) if garage_on else [],
        "garage_keys": list_garage_keys(state) if garage_on else [],
        "realm": realm,
        "ip": primary.get("ip") or live["ip"],
        "prefix": str(primary.get("prefix") or live["prefix"]),
        "gateway": primary.get("gateway") or live["gateway"],
        "interface": primary.get("interface") or live["interface"],
        "dhcp_start": primary.get("dhcp_start") or "",
        "dhcp_end": primary.get("dhcp_end") or "",
        "dns_forwarder": primary.get("dns_forwarder") or "",
        "vlans": state.get("vlans") or [],
        "hosts": state.get("hosts") or [],
        "shares": parse_shares() or state.get("shares") or [],
        "kea_pools": parse_kea_pools(),
        "users": list_users(mode),
        "packages": package_catalog(mode, bool(dhcp_on), garage_on),
        "version": HELPER_VERSION,
    }
    print(json.dumps(out))


def nm_active_con(iface: str) -> str:
    r = run(["nmcli", "-t", "-f", "NAME,DEVICE,TYPE", "con", "show", "--active"], check=False)
    for line in r.stdout.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and (not iface or parts[1] == iface):
            return parts[0]
    r = run(["nmcli", "-t", "-f", "NAME,DEVICE,TYPE", "con", "show"], check=False)
    for line in r.stdout.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and (not iface or parts[1] == iface):
            return parts[0]
    die("no NetworkManager connection found")
    return ""


def nm_set_ipv4(con: str, ip: str, prefix: str, gateway: str, dns: str) -> None:
    args = [
        "nmcli", "con", "mod", con,
        "ipv4.method", "manual",
        "ipv4.addresses", f"{ip}/{prefix}",
        "ipv4.ignore-auto-dns", "yes",
    ]
    if gateway:
        args += ["ipv4.gateway", gateway]
    if dns:
        args += ["ipv4.dns", dns]
    run(args)
    run(["nmcli", "con", "up", con])


def cidr_of(ip: str, prefix: str | int) -> str:
    net = ipaddress.ip_network(f"{ip}/{prefix}", strict=False)
    return str(net)


def reverse_zone_name(ip: str, prefix: str | int) -> str:
    net = ipaddress.ip_network(f"{ip}/{prefix}", strict=False)
    if net.prefixlen not in (8, 16, 24):
        # Samba reverse zones are easiest on octet boundaries; use /24 of the address
        parts = ip.split(".")
        return f"{parts[2]}.{parts[1]}.{parts[0]}.in-addr.arpa"
    rev = ipaddress.ip_network(net.network_address.exploded + f"/{net.prefixlen}").network_address.reverse_pointer
    # 0.1.168.192.in-addr.arpa -> drop host labels for the zone
    labels = rev.split(".")
    drop = {8: 3, 16: 2, 24: 1}[net.prefixlen]
    return ".".join(labels[drop:])


def ensure_reverse_zone(zone: str) -> None:
    if not Path("/var/lib/samba/private/sam.ldb").is_file():
        return
    r = run(["samba-tool", "dns", "zonelist", "localhost"], check=False)
    if zone.lower() in (r.stdout or "").lower():
        return
    run(["samba-tool", "dns", "zonecreate", "localhost", zone], check=False)


def subnet_entry(net: dict, subnet_id: int, dns_ip: str, domain: str) -> dict:
    ip = net["ip"]
    prefix = str(net.get("prefix") or "24")
    iface = net.get("ifname") or net.get("interface") or ""
    start = net.get("dhcp_start") or ""
    end = net.get("dhcp_end") or ""
    gw = net.get("gateway") or ip
    options = [
        {"name": "routers", "data": gw},
        {"name": "domain-name-servers", "data": dns_ip},
    ]
    if domain:
        options.append({"name": "domain-name", "data": domain})
        options.append({"name": "domain-search", "data": domain})
    entry: dict = {
        "id": subnet_id,
        "subnet": cidr_of(ip, prefix),
        "pools": [{"pool": f"{start} - {end}"}] if start and end else [],
        "option-data": options,
    }
    if iface:
        entry["interface"] = iface
    return entry


def rebuild_kea(state: dict) -> None:
    primary = state.get("primary") or {}
    if not primary.get("ip"):
        die("primary IP missing; set Network first")
    domain = (state.get("realm") or realm_from_smb() or "").lower()
    ifaces: list[str] = []
    subnets: list[dict] = []
    sid = 1
    piface = primary.get("interface") or ""
    if piface:
        ifaces.append(piface)
    dns_on = bool(state.get("dns_enabled", True))
    fwd = primary.get("dns_forwarder") or ""
    dns_ip = primary["ip"] if dns_on else (fwd or primary.get("gateway") or primary["ip"])
    subnets.append(subnet_entry(primary, sid, dns_ip, domain if dns_on else ""))
    sid += 1
    for v in state.get("vlans") or []:
        ifname = v.get("ifname") or f"{v.get('parent')}.{v.get('tag')}"
        v = {**v, "ifname": ifname}
        if ifname:
            ifaces.append(ifname)
        vlan_dns = v.get("ip") if dns_on else (fwd or v.get("gateway") or v.get("ip") or primary["ip"])
        subnets.append(subnet_entry(v, sid, vlan_dns, v.get("search_domain") or (domain if dns_on else "")))
        sid += 1
        if dns_on:
            ensure_reverse_zone(reverse_zone_name(v["ip"], v.get("prefix") or 24))
    if dns_on and primary.get("ip"):
        ensure_reverse_zone(reverse_zone_name(primary["ip"], primary.get("prefix") or 24))

    if KEA_CONF.is_file():
        try:
            data = json.loads(KEA_CONF.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            data = {}
    else:
        data = {}
    dhcp = data.setdefault("Dhcp4", {})
    dhcp["interfaces-config"] = {"interfaces": ifaces, "dhcp-socket-type": "raw"}
    dhcp["subnet4"] = subnets
    dhcp.setdefault("lease-database", {"type": "memfile", "persist": True, "name": "/var/lib/kea/dhcp4.leases"})
    dhcp.setdefault("valid-lifetime", 3600)
    KEA_CONF.parent.mkdir(parents=True, exist_ok=True)
    KEA_CONF.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    test = run(["kea-dhcp4", "-t", str(KEA_CONF)], check=False)
    if test.returncode != 0:
        die((test.stderr or test.stdout or "kea config invalid").strip())
    if state.get("dhcp_enabled", True):
        run(["systemctl", "enable", "--now", "kea-dhcp4.service"], check=False)
        run(["systemctl", "restart", "kea-dhcp4.service"], check=False)
    else:
        run(["systemctl", "disable", "--now", "kea-dhcp4.service"], check=False)


def cmd_apply_network(args: list[str]) -> None:
    need_root()
    if len(args) < 3:
        die("usage: apply-network IP PREFIX GATEWAY [IFACE] [DHCP_START] [DHCP_END] [DNS_FORWARDER]")
    ip, prefix, gateway = args[0], args[1], args[2]
    iface = args[3] if len(args) > 3 else ""
    dhcp_start = args[4] if len(args) > 4 else ""
    dhcp_end = args[5] if len(args) > 5 else ""
    dns_forwarder = args[6] if len(args) > 6 else ""
    if not Path("/usr/bin/nmcli").is_file() and not shutil_which("nmcli"):
        die("NetworkManager (nmcli) not found")
    con = nm_active_con(iface)
    nm_set_ipv4(con, ip, prefix, gateway, ip)
    state = load_state()
    state["realm"] = state.get("realm") or realm_from_smb()
    state["primary"] = {
        "interface": iface or live_ipv4().get("interface") or "",
        "ip": ip,
        "prefix": str(prefix),
        "gateway": gateway,
        "dhcp_start": dhcp_start,
        "dhcp_end": dhcp_end,
        "dns_forwarder": dns_forwarder,
    }
    save_state(state)
    if dhcp_start and dhcp_end and KEA_CONF.is_file():
        rebuild_kea(state)
    print(json.dumps({"ok": True, "connection": con}))


def shutil_which(name: str) -> str | None:
    from shutil import which
    return which(name)


def cmd_vlan_upsert(args: list[str]) -> None:
    need_root()
    if not args:
        die("usage: vlan-upsert JSON")
    spec = json.loads(args[0])
    tag = int(spec["tag"])
    if tag < 1 or tag > 4094:
        die("VLAN tag must be 1-4094")
    parent = spec["parent"]
    ip = spec["ip"]
    prefix = str(spec.get("prefix") or "24")
    gateway = spec.get("gateway") or ip
    dhcp_start = spec.get("dhcp_start") or ""
    dhcp_end = spec.get("dhcp_end") or ""
    search_domain = spec.get("search_domain") or ""
    ifname = spec.get("ifname") or f"{parent}.{tag}"
    con = f"vlan{tag}"
    if not shutil_which("nmcli"):
        die("NetworkManager (nmcli) not found")
    existing = run(["nmcli", "-t", "-f", "NAME", "con", "show"], check=False).stdout.splitlines()
    if con not in existing:
        run(
            [
                "nmcli", "con", "add", "type", "vlan", "con-name", con,
                "ifname", ifname, "dev", parent, "id", str(tag),
            ]
        )
    nm_set_ipv4(con, ip, prefix, gateway, ip)
    row = {
        "tag": tag,
        "parent": parent,
        "ifname": ifname,
        "ip": ip,
        "prefix": prefix,
        "gateway": gateway,
        "dhcp_start": dhcp_start,
        "dhcp_end": dhcp_end,
        "search_domain": search_domain,
        "connection": con,
    }
    state = load_state()
    vlans = [v for v in (state.get("vlans") or []) if int(v.get("tag") or 0) != tag]
    vlans.append(row)
    vlans.sort(key=lambda v: int(v.get("tag") or 0))
    state["vlans"] = vlans
    state["realm"] = state.get("realm") or realm_from_smb()
    save_state(state)
    if KEA_CONF.is_file() or dhcp_start:
        rebuild_kea(state)
    print(json.dumps({"ok": True, "vlan": row}))


def cmd_vlan_delete(args: list[str]) -> None:
    need_root()
    if not args:
        die("usage: vlan-delete TAG")
    tag = int(args[0])
    state = load_state()
    kept = []
    found = None
    for v in state.get("vlans") or []:
        if int(v.get("tag") or 0) == tag:
            found = v
        else:
            kept.append(v)
    if not found:
        die(f"no VLAN {tag}")
    con = found.get("connection") or f"vlan{tag}"
    run(["nmcli", "con", "down", con], check=False)
    run(["nmcli", "con", "delete", con], check=False)
    state["vlans"] = kept
    save_state(state)
    if KEA_CONF.is_file():
        rebuild_kea(state)
    print(json.dumps({"ok": True, "deleted": tag}))


def cmd_dns_add(args: list[str]) -> None:
    need_root()
    if len(args) < 3:
        die("usage: dns-add ZONE NAME IP")
    zone, name, ip = args[0], args[1], args[2]
    run(["samba-tool", "dns", "add", "localhost", zone, name, "A", ip], check=False)
    state = load_state()
    hosts = [h for h in (state.get("hosts") or []) if not (h.get("name") == name and h.get("ip") == ip)]
    hosts.append({"name": name, "ip": ip, "zone": zone})
    state["hosts"] = hosts
    save_state(state)
    print(json.dumps({"ok": True}))


def cmd_dns_del(args: list[str]) -> None:
    need_root()
    if len(args) < 3:
        die("usage: dns-del ZONE NAME IP")
    zone, name, ip = args[0], args[1], args[2]
    run(["samba-tool", "dns", "delete", "localhost", zone, name, "A", ip], check=False)
    state = load_state()
    state["hosts"] = [
        h for h in (state.get("hosts") or [])
        if not (h.get("name") == name and h.get("ip") == ip)
    ]
    save_state(state)
    print(json.dumps({"ok": True}))


def cmd_share_add(args: list[str]) -> None:
    need_root()
    if len(args) < 2:
        die("usage: share-add NAME PATH [MODE] [READONLY] [VALID_USERS]")
    name, path = args[0], args[1]
    mode = args[2] if len(args) > 2 else "0770"
    readonly = args[3] if len(args) > 3 else "no"
    valid = args[4] if len(args) > 4 else ""
    Path(path).mkdir(parents=True, exist_ok=True)
    os.chmod(path, int(mode, 8))
    text = SMB_CONF.read_text(encoding="utf-8") if SMB_CONF.is_file() else ""
    if f"[{name}]" not in text:
        block = (
            f"\n[{name}]\n"
            f"   path = {path}\n"
            f"   read only = {readonly}\n"
            f"   vfs objects = acl_xattr\n"
            f"   map acl inherit = yes\n"
            f"   store dos attributes = yes\n"
        )
        if valid:
            block += f"   valid users = {valid}\n"
        SMB_CONF.parent.mkdir(parents=True, exist_ok=True)
        SMB_CONF.write_text(text + block, encoding="utf-8")
    run(["smbcontrol", "all", "reload-config"], check=False)
    print(json.dumps({"ok": True}))


def cmd_share_perm(args: list[str]) -> None:
    need_root()
    if len(args) < 2:
        die("usage: share-perm PATH MODE")
    path, mode = args[0], args[1]
    os.chmod(path, int(mode, 8))
    print(json.dumps({"ok": True}))



def existing_share_blocks(text: str) -> str:
    skip = {"global", "netlogon", "sysvol", "printers", "print$"}
    lines = text.splitlines()
    out = []
    keep = False
    buf = []
    section = ""
    for line in lines + ["[end]"]:
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            if keep and section.lower() not in skip:
                out.extend(buf)
            section = s[1:-1]
            buf = [line]
            keep = True
            continue
        if keep:
            buf.append(line)
    return "\n".join(out).rstrip() + ("\n" if out else "")


def write_standalone_smb(state: dict) -> None:
    if is_dc():
        die("this box is an AD DC (sam.ldb present); demote before switching to local users")
    workgroup = (state.get("workgroup") or (state.get("realm") or "OFFICE").split(".")[0] or "OFFICE").upper()
    shares = existing_share_blocks(SMB_CONF.read_text(encoding="utf-8") if SMB_CONF.is_file() else "")
    body = (
        "[global]\n"
        f"   workgroup = {workgroup}\n"
        "   server role = standalone server\n"
        "   security = user\n"
        "   map to guest = never\n"
        "   vfs objects = acl_xattr\n"
        "   map acl inherit = yes\n"
        "   store dos attributes = yes\n\n"
    )
    SMB_CONF.parent.mkdir(parents=True, exist_ok=True)
    SMB_CONF.write_text(body + shares, encoding="utf-8")


def write_member_smb(state: dict, realm: str, workgroup: str) -> None:
    if is_dc():
        die("this box is an AD DC; cannot join another domain until it is demoted")
    shares = existing_share_blocks(SMB_CONF.read_text(encoding="utf-8") if SMB_CONF.is_file() else "")
    realm_u = realm.upper()
    wg = workgroup.upper()
    body = (
        "[global]\n"
        f"   workgroup = {wg}\n"
        f"   realm = {realm_u}\n"
        "   security = ads\n"
        "   server role = member server\n"
        "   kerberos method = secrets and keytab\n"
        "   winbind enum users = yes\n"
        "   winbind enum groups = yes\n"
        "   winbind use default domain = yes\n"
        "   idmap config * : backend = tdb\n"
        "   idmap config * : range = 3000-7999\n"
        f"   idmap config {wg} : backend = rid\n"
        f"   idmap config {wg} : range = 10000-999999\n"
        "   template shell = /usr/bin/nologin\n"
        "   vfs objects = acl_xattr\n"
        "   map acl inherit = yes\n"
        "   store dos attributes = yes\n\n"
    )
    SMB_CONF.parent.mkdir(parents=True, exist_ok=True)
    SMB_CONF.write_text(body + shares, encoding="utf-8")


def write_krb5(realm: str, kdc: str) -> None:
    realm_u = realm.upper()
    Path("/etc/krb5.conf").write_text(
        "[libdefaults]\n"
        f"    default_realm = {realm_u}\n"
        "    dns_lookup_realm = false\n"
        "    dns_lookup_kdc = true\n\n"
        f"[realms]\n"
        f"{realm_u} = {{\n"
        f"    kdc = {kdc}\n"
        f"    admin_server = {kdc}\n"
        "}\n\n"
        f"[domain_realm]\n"
        f".{realm.lower()} = {realm_u}\n"
        f"{realm.lower()} = {realm_u}\n",
        encoding="utf-8",
    )


def nss_add_winbind() -> None:
    nss = Path("/etc/nsswitch.conf")
    if not nss.is_file():
        return
    lines = nss.read_text(encoding="utf-8").splitlines()
    out = []
    for line in lines:
        if line.startswith("passwd:") and "winbind" not in line:
            line = line + " winbind"
        elif line.startswith("group:") and "winbind" not in line:
            line = line + " winbind"
        out.append(line)
    nss.write_text("\n".join(out) + "\n", encoding="utf-8")


def cmd_set_mode(args: list[str]) -> None:
    need_root()
    if not args:
        die("usage: set-mode host-ad|join-ad|local")
    mode = args[0]
    if mode not in ("host-ad", "join-ad", "local"):
        die("mode must be host-ad, join-ad, or local")
    state = load_state()
    if mode != "host-ad" and is_dc():
        die("this box already hosts AD. Demote/remove sam.ldb before joining or going local.")
    state["mode"] = mode
    save_state(state)
    if mode == "local":
        write_standalone_smb(state)
        run(["systemctl", "disable", "--now", "samba.service"], check=False)
        run(["systemctl", "disable", "--now", "winbind.service"], check=False)
        run(["systemctl", "enable", "--now", "smb.service"], check=False)
        run(["systemctl", "enable", "--now", "wsdd.service"], check=False)
        run(["smbcontrol", "all", "reload-config"], check=False)
    elif mode == "host-ad":
        if is_dc():
            run(["systemctl", "disable", "--now", "smb.service"], check=False)
            run(["systemctl", "disable", "--now", "nmb.service"], check=False)
            run(["systemctl", "disable", "--now", "winbind.service"], check=False)
            run(["systemctl", "enable", "--now", "samba.service"], check=False)
    print(json.dumps({"ok": True, "mode": mode, "needs_setup": mode == "host-ad" and not is_dc()}))


def flag_on(value) -> bool:
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in ("1", "true", "yes", "on")


def parse_service_args(args: list[str]) -> dict:
    spec: dict = {}
    i = 0
    while i < len(args):
        a = str(args[i])
        if a.startswith("{") and "}" in a:
            try:
                spec.update(json.loads(a))
            except json.JSONDecodeError:
                pass
            i += 1
            continue
        if a in ("--dhcp", "--dns", "--garage", "dhcp", "dns", "garage"):
            key = a.lstrip("-")
            val = args[i + 1] if i + 1 < len(args) else "on"
            spec[key] = flag_on(val)
            i += 2
            continue
        if "=" in a:
            k, v = a.split("=", 1)
            spec[k.strip().lstrip("-")] = flag_on(v)
            i += 1
            continue
        i += 1
    for k in ("dhcp", "dns", "garage"):
        if k in spec:
            spec[k] = flag_on(spec[k])
    return spec


def cmd_set_services(args: list[str]) -> None:
    need_root()
    if not args:
        die("usage: set-services dhcp=on|off [dns=on|off] [garage=on|off]")
    spec = parse_service_args(args)
    payload = {
        "version": HELPER_VERSION,
        "argv": args,
        "spec": spec,
    }
    log_last_apply(payload)
    if not spec:
        die("no dhcp/dns/garage flag in: " + " ".join(args))
    state = load_state()
    prev_garage = bool(state.get("garage_enabled", False))
    if "dhcp" in spec:
        state["dhcp_enabled"] = bool(spec["dhcp"])
    if "dns" in spec:
        state["dns_enabled"] = bool(spec["dns"])
    if "garage" in spec:
        state["garage_enabled"] = bool(spec["garage"])
    save_state(state)
    if "dhcp" in spec:
        if state["dhcp_enabled"]:
            primary = state.get("primary") or {}
            if primary.get("ip"):
                rebuild_kea(state)
            else:
                set_kea(True)
        else:
            set_kea(False)
    if "garage" in spec:
        try:
            set_garage(bool(state["garage_enabled"]), state)
        except SystemExit:
            state["garage_enabled"] = prev_garage
            save_state(state)
            raise
    parts = []
    if "dhcp" in spec or "dns" in spec:
        parts.append("DHCP is " + ("ON" if state.get("dhcp_enabled") else "OFF"))
        parts.append("DNS is " + ("ON" if state.get("dns_enabled") else "OFF"))
    if "garage" in spec:
        parts.append("Garage is " + ("ON" if state.get("garage_enabled") else "OFF"))
    out = {
        "ok": True,
        "version": HELPER_VERSION,
        "dhcp_enabled": bool(state.get("dhcp_enabled")),
        "dns_enabled": bool(state.get("dns_enabled")),
        "garage_enabled": bool(state.get("garage_enabled", False)),
        "kea": unit_active("kea-dhcp4.service"),
        "garage": unit_active(GARAGE_UNIT),
        "s3_endpoint": s3_endpoint_host(state),
        "message": "  ·  ".join(parts) if parts else "Saved",
    }
    print(json.dumps(out), flush=True)


def cmd_join_ad(args: list[str]) -> None:
    need_root()
    if not args:
        die("usage: join-ad JSON")
    spec = json.loads(args[0])
    realm = (spec.get("realm") or "").strip()
    dc = (spec.get("dc") or "").strip()
    admin = (spec.get("admin") or "Administrator").strip()
    password = spec.get("password") or ""
    workgroup = (spec.get("workgroup") or realm.split(".")[0]).strip().upper()
    if not realm or not dc or not password:
        die("realm, dc, and password are required")
    if is_dc():
        die("this box hosts AD already")
    state = load_state()
    write_krb5(realm, dc)
    write_member_smb(state, realm, workgroup)
    nss_add_winbind()
    # Point DNS at the DC so Kerberos/SRV work before join
    iface = (state.get("primary") or {}).get("interface") or live_ipv4().get("interface") or ""
    try:
        con = nm_active_con(iface)
        run(["nmcli", "con", "mod", con, "ipv4.dns", dc, "ipv4.ignore-auto-dns", "yes"], check=False)
        run(["nmcli", "con", "up", con], check=False)
    except Exception:
        pass
    r = subprocess.run(
        ["net", "ads", "join", "-U", f"{admin}%{password}"],
        capture_output=True, text=True, timeout=90,
    )
    if r.returncode != 0:
        die((r.stderr or r.stdout or "domain join failed").strip())
    run(["systemctl", "disable", "--now", "samba.service"], check=False)
    run(["systemctl", "enable", "--now", "winbind.service"], check=False)
    run(["systemctl", "enable", "--now", "smb.service"], check=False)
    run(["systemctl", "enable", "--now", "wsdd.service"], check=False)
    state["mode"] = "join-ad"
    state["realm"] = realm.lower()
    state["workgroup"] = workgroup
    state["join_dc"] = dc
    save_state(state)
    print(json.dumps({"ok": True, "joined": realm}))


def cmd_user_add(args: list[str]) -> None:
    need_root()
    if not args:
        die("usage: user-add JSON")
    spec = json.loads(args[0])
    name = (spec.get("name") or "").strip()
    password = spec.get("password") or ""
    if not name or not password:
        die("name and password required")
    if not re.fullmatch(r"[a-zA-Z0-9._-]+", name):
        die("invalid username")
    state = load_state()
    mode = detect_mode(state)
    if mode == "host-ad":
        r = subprocess.run(
            ["samba-tool", "user", "create", name, password],
            capture_output=True, text=True, timeout=30,
        )
        if r.returncode != 0:
            die((r.stderr or r.stdout or "could not create domain user").strip())
    elif mode == "local":
        if not Path(f"/home/{name}").exists() and run(["id", name], check=False).returncode != 0:
            run(["useradd", "-m", "-s", "/usr/bin/nologin", name], check=False)
        r = subprocess.run(
            ["smbpasswd", "-s", "-a", name],
            input=f"{password}\n{password}\n",
            capture_output=True, text=True, timeout=20,
        )
        if r.returncode != 0:
            die((r.stderr or r.stdout or "smbpasswd failed").strip())
    else:
        die("user add is for Host AD or local users; joined boxes use the domain")
    print(json.dumps({"ok": True, "name": name}))


def cmd_user_del(args: list[str]) -> None:
    need_root()
    if not args:
        die("usage: user-del NAME")
    name = args[0]
    if not re.fullmatch(r"[a-zA-Z0-9._-]+", name):
        die("invalid username")
    state = load_state()
    mode = detect_mode(state)
    if mode == "host-ad":
        run(["samba-tool", "user", "delete", name], check=False)
    elif mode == "local":
        run(["smbpasswd", "-x", name], check=False)
        run(["userdel", name], check=False)
    else:
        die("user delete is for Host AD or local users")
    print(json.dumps({"ok": True, "deleted": name}))


def cmd_garage_bucket_create(args: list[str]) -> None:
    need_root()
    spec = parse_kv(args)
    name = (spec.get("name") or (args[0] if args and "=" not in args[0] else "")).strip()
    if not name or not valid_bucket_name(name):
        die("usage: garage-bucket-create name=BUCKET  (3–63 chars, lowercase, digits, . -)")
    if not load_state().get("garage_enabled"):
        die("Garage is off")
    r = garage_run(["bucket", "create", name], check=False)
    if r.returncode != 0:
        die((r.stderr or r.stdout or "bucket create failed").strip())
    state = load_state()
    cache_garage_inventory(state)
    if not any((b.get("name") == name) for b in (state.get("garage_buckets") or [])):
        state.setdefault("garage_buckets", []).append({"name": name, "id": ""})
    save_state(state)
    log_last_apply({"cmd": "garage-bucket-create", "name": name, "ok": True})
    print(json.dumps({"ok": True, "name": name, "message": "Created bucket " + name}))


def cmd_garage_bucket_delete(args: list[str]) -> None:
    need_root()
    spec = parse_kv(args)
    name = (spec.get("name") or (args[0] if args and "=" not in args[0] else "")).strip()
    if not name or not valid_bucket_name(name):
        die("usage: garage-bucket-delete name=BUCKET")
    if not load_state().get("garage_enabled"):
        die("Garage is off")
    r = garage_run(["bucket", "delete", "--yes", name], check=False)
    if r.returncode != 0:
        die((r.stderr or r.stdout or "bucket delete failed").strip())
    state = load_state()
    cache_garage_inventory(state)
    state["garage_buckets"] = [b for b in (state.get("garage_buckets") or []) if b.get("name") != name]
    save_state(state)
    log_last_apply({"cmd": "garage-bucket-delete", "name": name, "ok": True})
    print(json.dumps({"ok": True, "deleted": name, "message": "Deleted bucket " + name}))


def cmd_garage_key_create(args: list[str]) -> None:
    need_root()
    spec = parse_kv(args)
    name = (spec.get("name") or (args[0] if args and "=" not in args[0] else "")).strip()
    if not name or not valid_key_name(name):
        die("usage: garage-key-create name=KEY")
    if not load_state().get("garage_enabled"):
        die("Garage is off")
    r = garage_run(["key", "create", name], check=False)
    if r.returncode != 0:
        die((r.stderr or r.stdout or "key create failed").strip())
    parsed = parse_key_create(r.stdout or "")
    if not parsed.get("secret_key"):
        parsed = parse_key_create((r.stdout or "") + "\n" + (r.stderr or ""))
    state = load_state()
    cache_garage_inventory(state)
    kid = parsed.get("key_id") or ""
    kn = parsed.get("key_name") or name
    keys = [k for k in (state.get("garage_keys") or []) if k.get("id") != kid and k.get("name") != kn]
    keys.append({"id": kid, "name": kn})
    state["garage_keys"] = keys
    save_state(state)
    log_last_apply({
        "cmd": "garage-key-create",
        "name": name,
        "key_id": parsed.get("key_id") or "",
        "ok": True,
    })
    print(json.dumps({
        "ok": True,
        "key_name": parsed.get("key_name") or name,
        "key_id": parsed.get("key_id") or "",
        "secret_key": parsed.get("secret_key") or "",
        "message": "Created key " + name + ". Secret is shown once below.",
    }))


def cmd_garage_bucket_allow(args: list[str]) -> None:
    need_root()
    spec = parse_kv(args)
    bucket = (spec.get("bucket") or spec.get("name") or "").strip()
    key = (spec.get("key") or "").strip()
    if not bucket or not key:
        die("usage: garage-bucket-allow bucket=BUCKET key=KEY")
    if not load_state().get("garage_enabled"):
        die("Garage is off")
    r = garage_run(
        ["bucket", "allow", "--read", "--write", "--key", key, bucket],
        check=False,
    )
    if r.returncode != 0:
        die((r.stderr or r.stdout or "bucket allow failed").strip())
    log_last_apply({
        "cmd": "garage-bucket-allow",
        "bucket": bucket,
        "key": key,
        "ok": True,
    })
    print(json.dumps({
        "ok": True,
        "bucket": bucket,
        "key": key,
        "message": "Allowed " + key + " read/write on " + bucket,
    }))


COMMANDS = {
    "status": cmd_status,
    "apply-network": cmd_apply_network,
    "vlan-upsert": cmd_vlan_upsert,
    "vlan-delete": cmd_vlan_delete,
    "dns-add": cmd_dns_add,
    "dns-del": cmd_dns_del,
    "share-add": cmd_share_add,
    "share-perm": cmd_share_perm,
    "set-mode": cmd_set_mode,
    "set-services": cmd_set_services,
    "join-ad": cmd_join_ad,
    "user-add": cmd_user_add,
    "user-del": cmd_user_del,
    "packages-install": cmd_packages_install,
    "garage-bucket-create": cmd_garage_bucket_create,
    "garage-bucket-delete": cmd_garage_bucket_delete,
    "garage-key-create": cmd_garage_key_create,
    "garage-bucket-allow": cmd_garage_bucket_allow,
}


def main() -> None:
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except Exception:
        pass
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    fn = COMMANDS.get(cmd)
    if not fn:
        die("unknown command " + cmd)
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()
